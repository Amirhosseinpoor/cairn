{
  "ruleset_version": "1",
  "readonly_commands": "(ls|cat|head|tail|wc|find|fd|tree|which|pwd|echo|printenv|env|git (status|log|diff|show|branch|remote -v|blame|config --get)|rg|grep|egrep|fgrep|sed -n|awk|ps|df|du|id|uname|node --version|python --version|pip --version|npm --version|cargo --version|go version|make -n|jq|curl -I)( .*)?",
  "rules": [
    {"id": "D1", "actions": ["read_file", "list_dir", "glob", "grep", "git_status", "git_diff", "job_output"],
     "target": {"kind": "any"},
     "effects": {"plan": "allow", "build": "allow", "auto": "allow", "auto-unsafe": "allow"}},
    {"id": "D2", "actions": ["todo_write"],
     "target": {"kind": "path_glob", "value": ".cairn/**"},
     "effects": {"plan": "allow", "build": "allow", "auto": "allow", "auto-unsafe": "allow"}},
    {"id": "D3", "actions": ["write_file", "edit_file", "multi_edit"],
     "target": {"kind": "path_glob", "value": "**"},
     "effects": {"plan": "deny", "build": "ask", "auto": "ask", "auto-unsafe": "allow"}},
    {"id": "D4", "actions": ["bash"],
     "target": {"kind": "command_regex", "value": "$readonly"},
     "effects": {"plan": "ask", "build": "ask", "auto": "allow", "auto-unsafe": "allow"}},
    {"id": "D5", "actions": ["bash"],
     "target": {"kind": "any"}, "except": {"kind": "command_regex", "value": "$readonly"},
     "effects": {"plan": "deny", "build": "ask", "auto": "ask", "auto-unsafe": "allow"}},
    {"id": "D6", "actions": ["git_commit"],
     "target": {"kind": "any"},
     "effects": {"plan": "deny", "build": "ask", "auto": "ask", "auto-unsafe": "allow"}},
    {"id": "D7", "actions": ["web_fetch"],
     "target": {"kind": "url_host", "value": "https://*"},
     "effects": {"plan": "ask", "build": "ask", "auto": "allow", "auto-unsafe": "allow"}},
    {"id": "D9", "actions": ["subagent"],
     "target": {"kind": "any"},
     "effects": {"plan": "ask", "build": "ask", "auto": "ask", "auto-unsafe": "allow"}},
    {"id": "D10", "actions": ["mcp__*"],
     "target": {"kind": "any"},
     "effects": {"plan": "ask", "build": "ask", "auto": "ask", "auto-unsafe": "allow"}},
    {"id": "D11", "actions": ["bash_background"],
     "target": {"kind": "command_regex", "value": "$readonly"},
     "effects": {"plan": "deny", "build": "ask", "auto": "allow", "auto-unsafe": "allow"}},
    {"id": "D11b", "actions": ["bash_background"],
     "target": {"kind": "any"}, "except": {"kind": "command_regex", "value": "$readonly"},
     "effects": {"plan": "deny", "build": "ask", "auto": "ask", "auto-unsafe": "allow"}},
    {"id": "D13", "actions": ["ask_user"],
     "target": {"kind": "any"},
     "effects": {"plan": "allow", "build": "allow", "auto": "allow", "auto-unsafe": "allow"}}
  ]
}
