{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "path",
    "edits"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string"
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "old_string",
          "new_string"
        ],
        "additionalProperties": false,
        "properties": {
          "old_string": {
            "type": "string",
            "minLength": 1
          },
          "new_string": {
            "type": "string"
          },
          "replace_all": {
            "type": "boolean",
            "default": false
          },
          "fuzzy": {
            "enum": [
              "off",
              "normal",
              "relaxed"
            ],
            "default": "normal"
          }
        }
      }
    },
    "expected_sha256": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "title": "multi_edit input",
  "description": "Apply several edits to one file, all or nothing: they run in order against an in-memory copy, and the file is written only if every edit applies and the result still parses. Edits that target the same text conflict."
}
