{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": [
        "string",
        "null"
      ]
    },
    "ahead": {
      "type": "integer"
    },
    "behind": {
      "type": "integer"
    },
    "staged": {
      "type": "array"
    },
    "unstaged": {
      "type": "array"
    },
    "untracked": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
